NODE_ENV=development
PORT=3000

# Firebase Web SDK (a API key web é pública; configure a mesma chave do app Web)
FIREBASE_WEB_API_KEY=
FIREBASE_PROJECT_ID=alertasrdprime
FIREBASE_DATABASE_URL=https://alertasrdprime-default-rtdb.firebaseio.com

# Firebase Admin SDK: JSON completo da service account, somente no ambiente
FIREBASE_SERVICE_ACCOUNT=


# Gere com: openssl rand -base64 48. Nunca compartilhe nem versione este valor
SESSION_SECRET=
